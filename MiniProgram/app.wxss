page { background: #f6f8fb; color: #172033; font-size: 28rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 6rpx 24rpx rgba(30, 55, 90, .06); }
.muted { color: #7c8799; font-size: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.button-primary { background: #1677ff; color: #fff; border-radius: 12rpx; }
.button-plain { color: #1677ff; background: #eaf3ff; border-radius: 12rpx; }
button::after { border: 0; }
.section-title { font-size: 30rpx; font-weight: 700; margin: 24rpx 0 16rpx; }
.form-row { display: flex; align-items: center; min-height: 92rpx; border-bottom: 1rpx solid #eef1f5; }
.form-label { width: 180rpx; color: #596579; }
input { flex: 1; text-align: right; }
