.page{min-height:100vh;padding-bottom:150rpx;background:#f5f6f8;color:#202735}.topbar{display:flex;align-items:center;justify-content:space-between;padding:40rpx 32rpx 16rpx;background:#fff}.title{font-size:42rpx;font-weight:700}.top-date{margin-top:8rpx;color:#8a919c;font-size:24rpx}.list-button{font-size:50rpx;transform:rotate(90deg)}.week-toolbar{padding:14rpx 18rpx;background:#fff}.week-pill{width:96rpx;padding:12rpx 0;border-radius:14rpx;background:#f0f1f3;text-align:center;font-weight:700;font-size:23rpx}.week-swiper{background:#fff}.schedule-content{width:100%;background:#fff}.week-head,.schedule-row{display:flex;width:100%}.week-head{border-bottom:1rpx solid #eceef1}.day{flex:1;min-width:0;padding:14rpx 0 12rpx;text-align:center;color:#333b47;font-size:22rpx}.day.today{color:#ee4350}.day-date{display:block;margin-top:6rpx;font-size:19rpx}.period-label{width:70rpx;flex-shrink:0;display:flex;flex-direction:column;align-items:center;justify-content:center}.period-index{font-size:27rpx;font-weight:700}.period-time{margin-top:3rpx;color:#9aa1aa;font-size:16rpx}.cell{flex:1;min-width:0;height:205rpx;padding:4rpx;box-sizing:border-box;border-right:1rpx solid #eceef1;border-bottom:1rpx solid #eceef1;background:#fff}.course-block{height:100%;box-sizing:border-box;padding:8rpx 5rpx;overflow:hidden;border-radius:8rpx;color:#202735;font-size:22rpx;line-height:1.25}.course-name,.course-meta{display:block;word-break:break-all}.course-name{margin-bottom:6rpx;font-weight:600}.course-meta{color:#606a78;font-size:17rpx}.break-row{width:100%;height:28rpx;background:#f0f1f3;color:#a0a6ad;text-align:center;font-size:18rpx;line-height:28rpx}.section-title{padding:28rpx 32rpx 14rpx;color:#606a78;font-size:25rpx}.custom-card{display:flex;align-items:center;gap:18rpx;margin:0 24rpx 14rpx}.custom-icon{color:#e84a8a;font-size:42rpx}.custom-main{flex:1}.muted{color:#8994a5;font-size:21rpx}.fab{position:fixed;right:34rpx;bottom:140rpx;width:112rpx;height:112rpx;padding:0;border:0;border-radius:56rpx;background:#ff3b45;box-shadow:0 10rpx 22rpx rgba(255,59,69,.3);color:#fff;font-size:62rpx;line-height:106rpx}
