.page { min-height: 100vh; padding-bottom: 150rpx; background: #f5f6f8; color: #202735; }.topbar { display: flex; align-items: center; justify-content: space-between; padding: 40rpx 36rpx 16rpx; background: #fff; }.title { font-size: 42rpx; font-weight: 700; line-height: 1.2; }.top-date { margin-top: 8rpx; color: #8a919c; font-size: 24rpx; }.list-button { font-size: 50rpx; line-height: 1; transform: rotate(90deg); color: #252b35; }.week-toolbar { padding: 14rpx 18rpx; background: #fff; }.week-pill { width: 96rpx; padding: 12rpx 0; border-radius: 14rpx; background: #f0f1f3; text-align: center; font-weight: 700; font-size: 23rpx; }.chevron { color: #9aa1aa; }.schedule-scroll { width: 100%; background: #fff; }.schedule-content { min-width: 1120rpx; background: #fff; }.week-head, .schedule-row { display: flex; min-width: 1120rpx; }.week-head { border-bottom: 1rpx solid #eceef1; }.day { flex: 1; min-width: 144rpx; padding: 14rpx 0 12rpx; text-align: center; color: #333b47; }.day.today { color: #ee4350; }.day-label, .day-date { display: block; }.day-label { font-size: 24rpx; }.day-date { margin-top: 6rpx; font-size: 20rpx; }.period-label { width: 106rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }.period-index { font-size: 27rpx; font-weight: 700; }.period-time { margin-top: 3rpx; color: #9aa1aa; font-size: 17rpx; }.cell { flex: 1; min-width: 144rpx; height: 150rpx; padding: 4rpx; box-sizing: border-box; border-right: 1rpx solid #eceef1; border-bottom: 1rpx solid #eceef1; background: #fff; }.course-block { height: 100%; box-sizing: border-box; padding: 8rpx; overflow: hidden; border-radius: 8rpx; color: #202735; font-size: 23rpx; }.course-name, .course-meta { display: block; }.course-name { margin-bottom: 6rpx; font-weight: 600; }.course-meta { color: #606a78; font-size: 18rpx; }.break-row { min-width: 1120rpx; height: 28rpx; background: #f0f1f3; color: #a0a6ad; text-align: center; font-size: 18rpx; line-height: 28rpx; }.section-title { padding: 28rpx 32rpx 14rpx; color: #606a78; font-size: 25rpx; }.custom-card { display: flex; align-items: center; gap: 18rpx; margin: 0 24rpx 14rpx; }.custom-icon { color: #e84a8a; font-size: 42rpx; }.custom-main { flex: 1; }.muted { color: #8994a5; font-size: 21rpx; }.fab { position: fixed; right: 34rpx; bottom: 140rpx; width: 112rpx; height: 112rpx; padding: 0; border: 0; border-radius: 56rpx; background: #ff3b45; box-shadow: 0 10rpx 22rpx rgba(255,59,69,.3); color: #fff; font-size: 62rpx; line-height: 106rpx; }
