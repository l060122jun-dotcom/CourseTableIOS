.header { display: flex; align-items: center; justify-content: space-between; }.add { margin: 0; padding: 0 20rpx; font-size: 24rpx; line-height: 72rpx; }.week-head, .schedule-row { display: flex; min-width: 1120rpx; }.week-head { margin-bottom: 12rpx; }.day { flex: 1; text-align: center; color: #68758a; font-size: 23rpx; }.period-label { width: 78rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }.period-index { font-weight: 700; }.period-time { font-size: 18rpx; color: #8994a5; margin-top: 4rpx; }.cell { flex: 1; height: 112rpx; margin: 3rpx; padding: 10rpx; box-sizing: border-box; border-radius: 10rpx; background: #edf4ff; font-size: 21rpx; overflow: hidden; }.schedule-scroll { width: 100%; }.schedule-content { min-width: 1120rpx; }.custom-card { display: flex; align-items: center; gap: 18rpx; }.custom-icon { color: #e84a8a; font-size: 42rpx; }.custom-main { flex: 1; }.course-name { font-weight: 600; margin-bottom: 6rpx; }
