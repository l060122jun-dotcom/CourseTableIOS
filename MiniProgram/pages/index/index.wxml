<view class="page"><view class="topbar"><view><view class="title">{{table.name}}</view><view class="top-date">{{todayLabel}}</view></view><view class="list-button" bindtap="openSettings">☷</view></view><view class="week-toolbar"><picker mode="selector" range="{{weekLabels}}" value="{{weekIndex}}" bindchange="weekChange"><view class="week-pill">{{currentWeek}} 周 <text>⌄</text></view></picker></view><swiper class="week-swiper" style="height:{{swiperHeight}}rpx" current="{{weekIndex}}" duration="260" bindchange="weekSwipe"><swiper-item wx:for="{{weekPages}}" wx:key="week" wx:for-item="weekPage"><view class="schedule-content"><view class="week-head"><view class="period-label"></view><block wx:for="{{weekPage.headers}}" wx:key="date"><view class="day {{item.current ? 'today' : ''}}"><text>周{{item.label}}</text><text class="day-date">{{item.date}}</text></view></block></view><view class="schedule"><block wx:for="{{periodRows}}" wx:key="index" wx:for-item="period"><view class="schedule-row"><view class="period-label"><text class="period-index">{{period.index}}</text><text class="period-time">{{period.start}}</text><text class="period-time">{{period.end}}</text></view><block wx:for="{{days}}" wx:key="*this" wx:for-item="day" wx:for-index="dayIndex"><view class="cell"><block wx:for="{{weekPage.courses}}" wx:key="id" wx:for-item="course"><block wx:if="{{course.weekday === dayIndex + 1 && course.timingMode === 'period' && course.startPeriod === period.index}}"><view class="course-block" style="background-color:{{course.color}};height:{{course.spanHeight}}rpx" data-id="{{course.id}}" bindtap="openDetail"><text class="course-name">{{course.name}}</text><text class="course-meta">{{course.location}}</text></view></block></block></view></block></view><view wx:if="{{period.index === 4 || period.index === 8}}" class="break-row"><text>{{period.index === 4 ? '午休' : '晚休'}}</text></view></block></view></view></swiper-item></swiper><view class="section-title" wx:if="{{customCourses.length}}">不规则时间课程</view><block wx:for="{{customCourses}}" wx:key="id"><view class="card custom-card" data-id="{{item.id}}" bindtap="openDetail"><view class="custom-icon">◷</view><view class="custom-main"><view class="course-name">{{item.name}}</view><view class="muted">周{{days[item.weekday - 1]}} · {{item.customStart}}–{{item.customEnd}}</view></view><view class="muted">{{item.location}}</view></view></block><button class="fab" bindtap="newCourse">＋</button></view>
