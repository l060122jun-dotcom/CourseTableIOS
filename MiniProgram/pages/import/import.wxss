.topbar{height:88rpx;display:flex;align-items:center;justify-content:center;background:#fff}.top-title{font-size:32rpx;font-weight:600}.hero{margin-top:20rpx}.hero .title{margin-bottom:12rpx}button{margin-bottom:20rpx}.tip{color:#a15c00;background:#fff7e6}.health{color:#176b45;background:#eaf8f0}.stepbar{display:flex;justify-content:space-between;align-items:center;padding:24rpx 32rpx;background:#fff;color:#1677ff;font-size:30rpx;font-weight:600}.step-current{color:#202735}.week-switch{display:flex;align-items:center;justify-content:space-between;padding:14rpx 24rpx;background:#f6f8fb;color:#4d596b}.week-switch button{margin:0;padding:0 18rpx;font-size:23rpx;line-height:58rpx;background:#fff;color:#1677ff}.week-head,.schedule-row{display:flex;width:100%;background:#fff}.week-head{border-bottom:1rpx solid #eceef1}.day{flex:1;text-align:center;padding:14rpx 0;color:#333b47;font-size:22rpx}.period-label{width:70rpx;flex-shrink:0;display:flex;flex-direction:column;align-items:center;justify-content:center}.period-time{font-size:16rpx;color:#9aa1aa;margin-top:3rpx}.cell{flex:1;min-width:0;height:190rpx;padding:4rpx;border-right:1rpx solid #eceef1;border-bottom:1rpx solid #eceef1;box-sizing:border-box}.course-block{height:100%;padding:8rpx 5rpx;box-sizing:border-box;border-radius:8rpx;font-size:22rpx;line-height:1.25;overflow:hidden;word-break:break-all}.course-meta{display:block;color:#606a78;font-size:17rpx;margin-top:6rpx}.raw{margin:20rpx}.result{background:#fff}
