<view class="page">
  <view class="topbar"><text class="top-title">确认识别结果</text></view>
  <view wx:if="{{!draft}}" class="choose">
    <view class="card hero"><view class="title">图片识别课程</view><view class="muted">选择课程表图片，识别结果会先进入课表确认。</view></view>
    <button class="button-primary" bindtap="chooseImage">从相册选择图片</button>
    <button class="button-plain" bindtap="chooseImage">选择本地图片</button>
    <button class="button-plain" bindtap="checkHealth">检查 OCR 服务</button>
  </view>
  <view wx:if="{{message}}" class="card tip">{{message}}</view>
  <view wx:if="{{healthMessage}}" class="card health">{{healthMessage}}</view>
  <view wx:if="{{draft}}" class="result {{transitionClass}}" bindtouchstart="weekTouchStart" bindtouchend="weekTouchEnd">
    <view class="stepbar"><text bindtap="backToChoose">上一步</text><text class="step-current">确认识别结果</text><text bindtap="confirmImport">下一步</text></view>
    <view class="card empty-result" wx:if="{{!previewCourses.length}}"><view class="section-title">没有可导入的结构化课程</view><view class="muted">已经保留模型识别文字，但没有识别出课程字段。请查看下方原文、重新截图识别，或手动新建课程；当前不会静默导入空课表。</view><button class="button-plain" bindtap="createCourse">手动新建课程</button></view>
    <picker mode="selector" range="{{weekOptions}}" value="{{currentWeekIndex}}" bindchange="weekChange"><view class="week-switch">第 {{currentWeek}} 周 <text class="week-picker-hint">选择周次⌄</text></view></picker>
    <view class="week-head"><view class="period-label"></view><block wx:for="{{days}}" wx:key="*this"><view class="day">周{{item}}</view></block></view>
    <block wx:for="{{periods}}" wx:key="index" wx:for-item="period">
      <view class="schedule-row"><view class="period-label"><text>{{period.index}}</text><text class="period-time">{{period.start}}</text><text class="period-time">{{period.end}}</text></view>
        <block wx:for="{{days}}" wx:key="*this" wx:for-item="day" wx:for-index="dayIndex"><view class="cell"><block wx:for="{{visibleCourses}}" wx:key="id" wx:for-item="course"><block wx:if="{{course.weekday === dayIndex + 1 && course.startPeriod === period.index}}"><view class="course-block" style="background-color:{{course.color || '#ffd9df'}};height:{{course.spanHeight || 182}}rpx"><text>{{course.name}}</text><text class="course-meta">{{course.location}}</text></view></block></block></view></block>
      </view>
    </block>
    <view class="card custom-result" wx:if="{{visibleCourses.length}}"><view class="section-title">本周识别候选</view><block wx:for="{{visibleCourses}}" wx:key="id"><view class="candidate-row"><text>{{item.name}}</text><text class="muted">周{{days[item.weekday - 1]}} · {{item.scheduleLabel}}</text></view></block></view>
    <view class="card raw" wx:if="{{draft.text}}"><view class="section-title">识别文字</view><text>{{draft.text}}</text><view class="muted">{{draft.warning}}</view></view>
  </view>
</view>
