<view class="page"><view class="topbar"><text class="top-title">确认识别结果</text></view><view wx:if="{{!draft}}" class="choose"><view class="card hero"><view class="title">图片识别课程</view><view class="muted">选择课程表图片，识别结果会先进入课表确认。</view></view><button class="button-primary" bindtap="chooseImage">从相册选择图片</button><button class="button-plain" bindtap="chooseImage">选择本地图片</button></view><view wx:if="{{message}}" class="card tip">{{message}}</view><view wx:if="{{draft}}" class="result"><view class="stepbar"><text bindtap="backToChoose">上一步</text><text class="step-current">确认识别结果</text><text bindtap="confirmImport">下一步</text></view><view class="week-head"><view class="period-label"></view><block wx:for="{{days}}" wx:key="*this"><view class="day">周{{item}}</view></block></view><block wx:for="{{periods}}" wx:key="index" wx:for-item="period"><view class="schedule-row"><view class="period-label"><text>{{period.index}}</text><text class="period-time">{{period.start}}</text><text class="period-time">{{period.end}}</text></view><block wx:for="{{days}}" wx:key="*this" wx:for-item="day" wx:for-index="dayIndex"><view class="cell"><block wx:for="{{previewCourses}}" wx:key="id" wx:for-item="course"><block wx:if="{{course.weekday === dayIndex + 1 && course.startPeriod === period.index}}"><view class="course-block" style="background-color:{{course.color || '#ffd9df'}}"><text>{{course.name}}</text><text class="course-meta">{{course.location}}</text></view></block></block></view></block></view></block><view class="card raw" wx:if="{{draft.text}}"><view class="section-title">识别文字</view><text>{{draft.text}}</text><view class="muted">{{draft.warning}}</view></view></view></view>
